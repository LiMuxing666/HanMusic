# Copy to secret.env on the server. Never ship it to the desktop client.
# Supply your private AudD token; there is intentionally no default/demo token.
AUDD_API_TOKEN=
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
BUDGET_FILE=/data/budget.json
IP_LIMIT_HOUR=10
DAILY_LIMIT=100
MAX_CONCURRENT=2
IP_CACHE_SIZE=4096
TRUST_PROXY_LOOPBACK=false
BODY_TIMEOUT_MS=10000
UPSTREAM_TIMEOUT_MS=25000
